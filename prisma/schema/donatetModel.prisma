model Donate {
  id String @id @default(uuid())

  status DonateStatus @default(UNPAID)

  amount   Decimal @db.Decimal(10, 2) 
  currency String  @default("BDT")

  paymentGateway        String @default("bkash")
  merchantInvoiceNumber String @unique

  bkashPaymentId String? @unique
  bkashTrxId     String?
  payerReference String? // user email / phone number
  paidAt         DateTime?

  gatewayResponse Json?

  donarId       String
  doner         User      @relation(fields: [donarId], references: [id]) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("donates")
}